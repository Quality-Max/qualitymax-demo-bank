{
  "version": 2,
  "functions": {
    "api/**/*.js": { "memory": 128 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler" },
    { "source": "/dashboard", "destination": "/views/dashboard.html" },
    { "source": "/transfer", "destination": "/views/transfer.html" },
    { "source": "/transactions", "destination": "/views/transactions.html" },
    { "source": "/settings", "destination": "/views/settings.html" },
    { "source": "/docs", "destination": "/views/docs.html" },
    { "source": "/login", "destination": "/views/login.html" },
    { "source": "/", "destination": "/views/login.html" }
  ]
}
